#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"

source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/commands/new.sh"
source "$SCRIPT_DIR/commands/update.sh"
source "$SCRIPT_DIR/commands/delete.sh"
source "$SCRIPT_DIR/commands/restart.sh"
source "$SCRIPT_DIR/commands/cert.sh"
source "$SCRIPT_DIR/commands/adddomain.sh"
source "$SCRIPT_DIR/commands/all.sh"
source "$SCRIPT_DIR/commands/banned.sh"
source "$SCRIPT_DIR/commands/status.sh"
source "$SCRIPT_DIR/commands/errors.sh"

main() {
    local command=${1:-}
    if [[ "$command" == "-h" || "$command" == "--help" || "$command" == "help" ]]; then
        usage
        exit 0
    fi

    if [[ -z "$command" ]]; then
        usage
        exit 2
    fi

    shift || true

    case "$command" in
        new)
            cmd_new "$@"
            ;;
        update)
            cmd_update "$@"
            ;;
        delete)
            cmd_delete "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        cert)
            cmd_cert "$@"
            ;;
        adddomain)
            cmd_adddomain "$@"
            ;;
        all)
            cmd_all "$@"
            ;;
        banned)
            cmd_banned "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        errors)
            cmd_errors "$@"
            ;;
        *)
            echo "Unknown command: $command" >&2
            usage
            exit 2
            ;;
    esac
}

main "$@"
