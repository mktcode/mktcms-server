#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: websitesall <command> [args...]" >&2
    echo "Runs the given command inside each website directory under /var/www/websites." >&2
    echo "Example: websitesall git pull" >&2
}

if (( $# < 1 )); then
    usage
    exit 2
fi

WEBSITES_ROOT="/var/www/websites"

if [[ ! -d "$WEBSITES_ROOT" ]]; then
    echo "Error: $WEBSITES_ROOT does not exist." >&2
    exit 1
fi

cd "$WEBSITES_ROOT"

shopt -s nullglob
website_dirs=(*/)
shopt -u nullglob

if (( ${#website_dirs[@]} == 0 )); then
    echo "No websites found in $WEBSITES_ROOT" >&2
    exit 0
fi

for website_dir in "${website_dirs[@]}"; do
    (
        cd "$website_dir"
        echo "== $website_dir =="
        "$@"
    )
done
